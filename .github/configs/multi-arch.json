{"name": "aarch64-gcm-table", "minutes": 4,
 "cc": "ccache aarch64-linux-gnu-gcc",
 "comment": "--enable-aesgcm=table selects the 8-bit GHASH table (GCM_TABLE); nothing else in CI builds it. On aarch64 the base GCM_gmult_len is reached only with NEON off, and configure always enables NEON there, so WOLFSSL_ARMASM_NO_NEON has to come from CPPFLAGS.",
 "configure": ["--host=aarch64-linux-gnu", "--enable-all",
  "--disable-examples", "--enable-sp-asm", "--enable-armasm",
  "--enable-aesgcm=table", "CPPFLAGS=-DWOLFSSL_ARMASM_NO_NEON",
  "CFLAGS=-O2"],
 "check": false,
 "run": [["env", "QEMU_LD_PREFIX=/usr/aarch64-linux-gnu", "./wolfcrypt/test/testwolfcrypt"]]},
{"name": "thumb2-gcm-table", "minutes": 3,
 "cc": "ccache arm-linux-gnueabi-gcc",
 "comment": "armv7m host_cpu selects the Thumb-2 assembly (WOLFSSL_ARMASM_THUMB2) built for armv7-r, which does run under qemu-arm.",
 "configure": ["--host=armv7m-linux-gnueabi", "--enable-all",
  "--disable-examples", "--enable-armasm", "--enable-aesgcm=table",
