+ * targets.  in_nmi(), in_serving_softirq() and in_interrupt() are spelled
+ * the same on all of them.
+ */
+#ifdef in_hardirq
+#define WOLFSSL_LINUXKM_IN_HARDIRQ() in_hardirq()
+#else
+#define WOLFSSL_LINUXKM_IN_HARDIRQ() in_irq()
+#endif
