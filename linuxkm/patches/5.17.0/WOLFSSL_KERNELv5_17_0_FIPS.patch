+/* Named in the WARN and in the panic: which context lost service is the
+ * first thing anyone reading the crash will want.
+ */
+static const char *wolfssl_linuxkm_grb_ctx(void)
+{
+    if (in_nmi())
+        return "NMI";
+    if (WOLFSSL_LINUXKM_IN_HARDIRQ())
+        return "hardirq";
+    if (in_serving_softirq())
+        return "softirq";
+    return "task";
+}
