+/* Requests a registered module handler declined WOLFSSL_LINUXKM_GRB_TRIES
+ * times.  READING 0 IS CORRECT AND EXPECTED on any machine that is up: the
+ * increment below is immediately followed by panic(), so a live system has
+ * by definition never taken that path.  A zero here is not a broken
+ * counter.  It is exported so a consumer can assert on it, and so that a
+ * future change which makes this path survivable stays measurable rather
+ * than only fatal.  See the note at the hook site in _get_random_bytes().
+ */
+#define WOLFSSL_LINUXKM_GRB_TRIES 3
+static atomic64_t wolfssl_linuxkm_grb_unserved = ATOMIC64_INIT(0);
+
+u64 wolfssl_linuxkm_random_bytes_unserved(void)
+{
+    return (u64)atomic64_read(&wolfssl_linuxkm_grb_unserved);
+}
+EXPORT_SYMBOL_GPL(wolfssl_linuxkm_random_bytes_unserved);
