#!/usr/bin/env bash

# rsapss.test

# timeout(1) is GNU coreutils and absent on macOS; where it's missing, run the
# command unbounded (the flaky hang this guards against is Linux-only CI).
# A prefix variable rather than a shell function: backgrounding a function
# makes $! the forked subshell, so a later "kill $server_pid" would stop the
# wrapper and orphan the server it was meant to kill.
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_KILL_2M="timeout -s KILL 2m"
else
    TIMEOUT_KILL_2M=""
fi

[ ! -x ./examples/client/client ] && printf '\n\n%s\n' "Client doesn't exist" \
                                  && exit 1

if ./examples/client/client -? 2>&1 | grep "Client not compiled in!" ; then
    echo 'skipping rsapss.test because client not compiled in.' 1>&2
    exit 77
fi

if ./examples/server/server -? 2>&1 | grep "Server not compiled in!" ; then
    echo 'skipping rsapss.test because server not compiled in.' 1>&2
    exit 77
fi

HAVE_TLS12=no
HAVE_TLS13=no
HAVE_DTLS12=no
./examples/client/client -V | grep -q 3 && HAVE_TLS12=yes
./examples/client/client -V | grep -q 4 && HAVE_TLS13=yes
if [ "$HAVE_TLS12" = yes ] && grep -q -- '-DWOLFSSL_DTLS\b' config.log 2>/dev/null; then
    HAVE_DTLS12=yes
fi
if [ "$HAVE_TLS12" = no ] && [ "$HAVE_TLS13" = no ]; then
    echo "skipping because neither TLS 1.2 nor TLS 1.3 is enabled in this build"
    exit 0
fi
if ! grep -q -- -DWC_RSA_PSS config.log 2>/dev/null; then
    echo "skipping because WC_RSA_PSS not enabled in this build"
    exit 0
fi
if ! grep -q -- '-DHAVE_ECC\>' config.log 2>/dev/null; then
    echo "skipping because HAVE_ECC not enabled in this build"
    exit 0
fi
if grep -q -- '-DNO_CODING' config.log 2>/dev/null; then
    echo "skipping because NO_CODING is defined in this build"
    exit 0
fi

CERT_DIR="$PWD/$(dirname "$0")/../certs"
if [ "$OPENSSL" = "" ]; then
    OPENSSL=openssl
fi

# if we can, isolate the network namespace to eliminate port collisions.
if [[ -n "$NETWORK_UNSHARE_HELPER" ]]; then
     if [[ -z "$NETWORK_UNSHARE_HELPER_CALLED" ]]; then
         export NETWORK_UNSHARE_HELPER_CALLED=yes
         exec "$NETWORK_UNSHARE_HELPER" "$0" "$@" || exit $?
     fi
elif [ "${AM_BWRAPPED-}" != "yes" ]; then
    bwrap_path="$(command -v bwrap)"
    if [ -n "$bwrap_path" ]; then
        export AM_BWRAPPED=yes
        exec "$bwrap_path" --unshare-net --dev-bind / / "$0" "$@"
    fi
    unset AM_BWRAPPED
fi

# need a unique port since may run the same time as testsuite
# Track ports already assigned in this script run to prevent intra-run collisions
used_ports=()

generate_port() {
    #-------------------------------------------------------------------------#
    # Generate a random port number, guaranteed unique within this script run.
    # Checks both the intra-run used_ports list and system-level bound ports.
    #-------------------------------------------------------------------------#
    local attempts=0 collision p

    while true; do
        if [[ "$OSTYPE" == "linux"* ]]; then
            p=$(($(od -An -N2 /dev/urandom) % (65535-49512) + 49512))
        elif [[ "$OSTYPE" == "darwin"* ]]; then
            p=$(($(od -An -N2 /dev/random) % (65535-49512) + 49512))
        else
            echo "skipping due to unsupported OS"
            exit 0
        fi

        # Check against ports already assigned in this run
        collision=0
        for up in "${used_ports[@]}"; do
            if [ "$up" = "$p" ]; then
                collision=1
                break
            fi
        done

        # Also check if the port is already bound on this system
        if [ "$collision" -eq 0 ]; then
            # TCP and UDP, established as well as listening, matched on the
            # local port. -lnt saw only TCP listeners, so it was blind to the
            # UDP sockets the DTLS cases here bind and to a port held by an
            # unrelated outbound connection - both of which still block bind.
            # A false positive only costs another iteration of this loop.
            if command -v ss &>/dev/null; then
                [ -n "$(ss -Hantu "sport = :${p}" 2>/dev/null)" ] && collision=1
            elif command -v netstat &>/dev/null; then
                netstat -an 2>/dev/null | grep -q "[:.]${p}[[:space:]]" && collision=1
            fi
        fi

        [ "$collision" -eq 0 ] && break

        ((attempts++))
        if [ "$attempts" -ge 100 ]; then
            echo "ERROR: generate_port could not find a free port after 100 attempts"
            exit 1
        fi
    done

    port=$p
    used_ports+=("$p")
}

WOLFSSL_SERVER=./examples/server/server
WOLFSSL_CLIENT=./examples/client/client

# id-RSASSA-PSS keys. The 2048-bit keys declare SHA-256 and a 32-byte salt,
# binding per RFC 4055 1.2; the 3072-bit keys declare no parameters.
PSS_SVR="-c $CERT_DIR/rsapss/server-rsapss.pem -k $CERT_DIR/rsapss/server-rsapss-priv.pem"
PSS3072_SVR="-c $CERT_DIR/rsapss/server-3072-rsapss.pem -k $CERT_DIR/rsapss/server-3072-rsapss-priv.pem"
PSS_CLI_OPENSSL="-cert $CERT_DIR/rsapss/client-rsapss.pem -key $CERT_DIR/rsapss/client-rsapss-priv.pem"
PSS_CLI_WOLFSSL="-c $CERT_DIR/rsapss/client-rsapss.pem -k $CERT_DIR/rsapss/client-rsapss-priv.pem"
PSS3072_CLI_WOLFSSL="-c $CERT_DIR/rsapss/client-3072-rsapss.pem -k $CERT_DIR/rsapss/client-3072-rsapss-priv.pem"
# rsaEncryption key, for the control cases.
RSA_SVR="-c $CERT_DIR/server-cert.pem -k $CERT_DIR/server-key.pem"

cases=0
fails=0

# The examples check CRLs whenever CRL support is compiled in, and the RSA-PSS
# test certificates have none, so turn that off on both sides.
SVR_NO_CRL=""
CLI_NO_CRL=""
if grep -q -- '-DHAVE_CRL\b' config.log 2>/dev/null; then
    SVR_NO_CRL="-V"
    CLI_NO_CRL="-C"
fi

if ! command -v "$OPENSSL" >/dev/null 2>&1; then
    echo "skipping because $OPENSSL is not available"
    exit 0
fi
# The rsa_pss_pss_* scheme names need OpenSSL 1.1.1 or later.
if ! "$OPENSSL" version 2>/dev/null | grep -Eq 'OpenSSL (1\.1\.1|[3-9]\.)'; then
    echo "skipping because $OPENSSL is older than 1.1.1"
    exit 0
fi

fail_case() {
    echo "FAIL: $1"
    echo "--- wolfSSL/OpenSSL server output ---"
    cat rsapss.server.log
    echo "--- client output ---"
    cat rsapss.client.log
    fails=$((fails+1))
}

# wolfSSL server, OpenSSL s_client: $1 name, $2 "Peer signature type" s_client
# must report or FAIL, $3 server arguments, $4 s_client arguments.
wolfssl_server_case() {
    local name="$1" expect="$2" sargs="$3" cargs="$4" result
    cases=$((cases+1))
    generate_port
    $TIMEOUT_KILL_2M $WOLFSSL_SERVER -p "$port" $SVR_NO_CRL $sargs \
        > rsapss.server.log 2>&1 &
    server_pid=$!
    sleep 1
    echo "test connection" | $TIMEOUT_KILL_2M $OPENSSL s_client \
        -connect 127.0.0.1:"$port" $cargs > rsapss.client.log 2>&1
    result=$?
    sleep 0.2
    kill $server_pid 2>/dev/null
    wait $server_pid 2>/dev/null
    if [ "$expect" = FAIL ]; then
        if [ "$result" = 0 ]; then
            fail_case "$name: handshake completed but must fail"
        fi
    elif [ "$result" != 0 ]; then
        fail_case "$name: handshake failed"
    elif ! grep -q "^Peer signature type: $expect\$" rsapss.client.log; then
        fail_case "$name: expected peer signature type $expect"
    fi
    rm -f rsapss.server.log rsapss.client.log
}

# OpenSSL s_server with client auth, wolfSSL client: $1 name, $2 OK (expects an
# rsa_pss_pss_* CertificateVerify) or FAIL, $3 s_server arguments, $4 client
# arguments, $5 client certificate and key arguments, $6 that self-signed
# certificate as the s_server trust anchor.
openssl_server_case() {
    local name="$1" expect="$2" sargs="$3" cargs="$4" ccert="$5" cca="$6"
    local result
    cases=$((cases+1))
    generate_port
    $TIMEOUT_KILL_2M $OPENSSL s_server -www -accept "$port" -Verify 1 \
        -CAfile "$cca" \
        -cert "$CERT_DIR"/server-cert.pem -key "$CERT_DIR"/server-key.pem \
        -msg $sargs > rsapss.server.log 2>&1 &
    server_pid=$!
    sleep 1
    $TIMEOUT_KILL_2M $WOLFSSL_CLIENT -p "$port" $CLI_NO_CRL -g \
        -A "$CERT_DIR"/ca-cert.pem $ccert $cargs > rsapss.client.log 2>&1
    result=$?
    kill $server_pid 2>/dev/null
    wait $server_pid 2>/dev/null
    if [ "$expect" = FAIL ]; then
        if [ "$result" = 0 ]; then
            fail_case "$name: handshake completed but must fail"
        fi
    elif [ "$result" != 0 ]; then
        fail_case "$name: handshake failed"
    elif ! grep -A1 'CertificateVerify' rsapss.server.log | \
            grep -Eq '^ +0f 00 [0-9a-f]{2} [0-9a-f]{2} 08 (09|0a|0b) '; then
        fail_case "$name: CertificateVerify is not rsa_pss_pss_*"
    fi
    rm -f rsapss.server.log rsapss.client.log
}

# An id-RSASSA-PSS key signs with rsa_pss_pss_* only, from the peer's offer, and
# an rsaEncryption key never does (RFC 8446 4.2.3); the schemes apply to
# (D)TLS 1.2 as well (RFC 8446 1.3).
for ver in tls12 tls13 dtls12; do
    case $ver in
        tls12)  [ "$HAVE_TLS12"  = yes ] || continue
                sv="-v 3";    cv="-tls1_2" ;;
        tls13)  [ "$HAVE_TLS13"  = yes ] || continue
                sv="-v 4";    cv="-tls1_3" ;;
        dtls12) [ "$HAVE_DTLS12" = yes ] || continue
                # Explicit MTU: s_client cannot query the loopback path MTU on
                # every platform and would otherwise fragment the ClientHello.
                sv="-v 3 -u"; cv="-dtls1_2 -mtu 1500" ;;
    esac
    wolfssl_server_case "$ver PSS server, default list" rsa_pss_pss_sha256 \
        "$sv -d $PSS_SVR" "$cv"
    wolfssl_server_case "$ver PSS server, rsa_pss_pss_sha256 only" rsa_pss_pss_sha256 \
        "$sv -d $PSS_SVR" "$cv -sigalgs rsa_pss_pss_sha256"
    wolfssl_server_case "$ver PSS server, key parameters fix SHA-256" FAIL \
        "$sv -d $PSS_SVR" "$cv -sigalgs rsa_pss_pss_sha384"
    wolfssl_server_case "$ver PSS 3072 server, rsa_pss_pss_sha384 only" rsa_pss_pss_sha384 \
        "$sv -d $PSS3072_SVR" "$cv -sigalgs rsa_pss_pss_sha384"
    wolfssl_server_case "$ver PSS 3072 server, rsa_pss_pss_sha512 only" rsa_pss_pss_sha512 \
        "$sv -d $PSS3072_SVR" "$cv -sigalgs rsa_pss_pss_sha512"
    wolfssl_server_case "$ver PSS 3072 server, hash from the pss_pss offer" rsa_pss_pss_sha384 \
        "$sv -d $PSS3072_SVR" "$cv -sigalgs rsa_pss_pss_sha384:rsa_pss_rsae_sha256"
    wolfssl_server_case "$ver PSS server, never rsa_pkcs1_*" rsa_pss_pss_sha256 \
        "$sv -d $PSS_SVR" "$cv -sigalgs rsa_pss_pss_sha256:rsa_pkcs1_sha256"
    wolfssl_server_case "$ver PSS server, hash from the pss_pss offer" rsa_pss_pss_sha256 \
        "$sv -d $PSS_SVR" "$cv -sigalgs rsa_pss_pss_sha256:rsa_pss_rsae_sha384"
    wolfssl_server_case "$ver PSS server, rsa_pss_rsae_* only offered" FAIL \
        "$sv -d $PSS_SVR" "$cv -sigalgs rsa_pss_rsae_sha256"
    wolfssl_server_case "$ver PSS server, PSS client certificate" rsa_pss_pss_sha256 \
        "$sv $PSS_SVR -A $CERT_DIR/rsapss/client-rsapss.pem" "$cv $PSS_CLI_OPENSSL"
    wolfssl_server_case "$ver rsaEncryption server, rsa_pss_rsae_*" rsa_pss_rsae_sha256 \
        "$sv -d $RSA_SVR" "$cv -sigalgs rsa_pss_rsae_sha256:rsa_pss_pss_sha256"
    wolfssl_server_case "$ver rsaEncryption server, rsa_pss_pss_* only offered" FAIL \
        "$sv -d $RSA_SVR" "$cv -sigalgs rsa_pss_pss_sha256"
done

for ver in tls12 tls13; do
    case $ver in
        tls12) [ "$HAVE_TLS12" = yes ] || continue
               ov="-tls1_2"; wv="-v 3" ;;
        tls13) [ "$HAVE_TLS13" = yes ] || continue
               ov="-tls1_3"; wv="-v 4" ;;
    esac
    cli="$PSS_CLI_WOLFSSL"
    cca="$CERT_DIR/rsapss/client-rsapss.pem"
    openssl_server_case "$ver PSS client, default list" OK \
        "$ov" "$wv" "$cli" "$cca"
    openssl_server_case "$ver PSS client, rsa_pss_pss_sha256 only" OK \
        "$ov -client_sigalgs rsa_pss_pss_sha256" "$wv" "$cli" "$cca"
    openssl_server_case "$ver PSS client, never rsa_pkcs1_*" OK \
        "$ov -client_sigalgs rsa_pss_pss_sha256:rsa_pkcs1_sha256" "$wv" "$cli" "$cca"
    openssl_server_case "$ver PSS client, rsa_pss_rsae_* only offered" FAIL \
        "$ov -client_sigalgs rsa_pss_rsae_sha256" "$wv" "$cli" "$cca"
    openssl_server_case "$ver PSS client, key parameters fix SHA-256" FAIL \
        "$ov -client_sigalgs rsa_pss_pss_sha384" "$wv" "$cli" "$cca"
    if [ "$ver" = tls12 ]; then
        openssl_server_case "$ver PSS client, rsa_pkcs1_* only offered" FAIL \
            "$ov -client_sigalgs rsa_pkcs1_sha256" "$wv" "$cli" "$cca"
    fi
    cli="$PSS3072_CLI_WOLFSSL"
    cca="$CERT_DIR/rsapss/client-3072-rsapss.pem"
    openssl_server_case "$ver PSS 3072 client, rsa_pss_pss_sha384 only" OK \
        "$ov -client_sigalgs rsa_pss_pss_sha384" "$wv" "$cli" "$cca"
done

if [ "$fails" != 0 ]; then
    echo -e "\n$fails of $cases cases failed\n"
    exit 1
fi
echo -e "\nSuccess! ($cases cases)\n\n"
exit 0
