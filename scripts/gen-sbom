#!/usr/bin/env python3
"""Forward to the vendored wolfssl-compliance-tooling generator.

The customer command stays `python3 scripts/gen-sbom`.
The implementation is tools/sbom/gen-sbom. A release tarball carries one copy.
"""
import os
import sys

_here = os.path.dirname(os.path.abspath(__file__))
_target = os.path.abspath(os.path.join(_here, os.pardir, "tools", "sbom", "gen-sbom"))
if not os.path.isfile(_target):
    sys.exit(f"ERROR: wolfssl-compliance-tooling generator not found at {_target}")
os.execv(sys.executable, [sys.executable, _target, *sys.argv[1:]])
